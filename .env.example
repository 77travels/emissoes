# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
# Chave usada para assinar as sessões de login. Troque por um valor aleatório longo.
SESSION_SECRET=troque-por-uma-chave-aleatoria-bem-longa

# Senha inicial do usuário master (gestao@77travels.com.br).
# Usada apenas na primeira execução, quando o banco é criado.
MASTER_INITIAL_PASSWORD=77travels

# ── OCR inteligente (recomendado) ───────────────────────────────────────────
# Com a chave da Anthropic o sistema lê qualquer voucher/confirmação (PDF ou
# imagem) com altíssima precisão. Sem a chave, usa OCR local (Tesseract) com
# regras de extração — funciona, mas com menor precisão.
ANTHROPIC_API_KEY=

# ── Google Drive / Sheets ───────────────────────────────────────────────────
# Crie um projeto em https://console.cloud.google.com, ative as APIs
# "Google Drive API" e "Google Sheets API", crie credenciais OAuth 2.0
# (tipo "Aplicativo da Web") e informe abaixo. O redirect URI deve ser:
#   https://SEU-DOMINIO/api/drive/callback   (ou http://localhost:3000/api/drive/callback em teste)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
